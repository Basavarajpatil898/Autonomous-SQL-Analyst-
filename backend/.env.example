APP_NAME=Autonomous SQL Analyst API
API_V1_PREFIX=/api/v1

DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/autonomous_sql_analyst

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_ATTEMPTS=3

GEMINI_API_KEY=your_new_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ATTEMPTS=2

REQUEST_TIMEOUT_SECONDS=90
DEFAULT_MAX_ROWS=50
ABSOLUTE_MAX_ROWS=500

CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:3000,http://localhost:3000